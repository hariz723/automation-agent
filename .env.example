# LLM Provider Configuration
# Choose either 'gemini' (recommended) or 'huggingface'
LLM_PROVIDER=gemini

# Google Gemini API Key (get one at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative environment variable name:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Options:
# gemini-2.5-flash (fast, powerful, default)
# gemini-2.5-pro (most capable for complex coding/reasoning)
# gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face API Token (optional, if using Hugging Face models)
# HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
# HF_TOKEN=your_huggingface_token_here
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Execution Configuration
MAX_STEP_RETRIES=2
TEMPERATURE=0.2
TIMEOUT_SECONDS=120
